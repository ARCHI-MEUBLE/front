# ArchiMeuble - Frontend Environment Variables Example
# Copiez ce fichier en .env.local et remplissez les valeurs
# Les autres configurations (Calendly, Crisp) sont maintenant dans back/.env

# Backend PHP API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe Publishable Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret partagé avec le backend (même valeur que FRONT_PROXY_SECRET dans back/.env, 32 caractères au moins).
# Le serveur Next s'en sert pour transmettre l'adresse des visiteurs au backend, qui compte ses limites anti-abus
# (connexion, devis, avis…) par visiteur. Sans lui, tous les visiteurs passant par Vercel partagent les mêmes limites.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FRONT_PROXY_SECRET=

# Chemin secret de l'admin (ex: Xk7-mP9_qW2rL5). Sans préfixe NEXT_PUBLIC_ : il ne doit pas être recopié dans le
# JavaScript envoyé aux navigateurs. L'ancien nom NEXT_PUBLIC_ADMIN_PATH est encore lu côté serveur, à renommer.
ADMIN_PATH=admin_secret_path

# Adresse canonique du site pour le referencement (optionnel, par defaut https://www.archimeuble.com)
# NEXT_PUBLIC_SITE_URL=https://www.archimeuble.com
